<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RcktMon.App.ViewModels"
        xmlns:fmt="using:RcktMon.App.Formatting"
        x:Class="RcktMon.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RcktMon"
        Width="1360" Height="860"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource Brush.Surface.1}">

    <Window.Resources>
        <fmt:ConnectionTextConverter x:Key="ConnText" />
        <fmt:ConnectionBrushConverter x:Key="ConnBrush" />
        <fmt:ResourceLookupConverter x:Key="Icon" />
    </Window.Resources>

    <Panel>

        <DockPanel>

            <!-- ============ app bar ============ -->
            <Border Classes="appbar" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="ghost" Command="{Binding ToggleRailCommand}"
                                AutomationProperties.Name="Свернуть или развернуть панель навигации">
                            <PathIcon Classes="rail" Data="{DynamicResource Icon.Instruments}" />
                        </Button>

                        <TextBlock Text="RcktMon" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />

                        <TextBlock Classes="tertiary" VerticalAlignment="Center"
                                   Text="{Binding CurrentPage.Title}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="secondary" VerticalAlignment="Center"
                                   Text="{Binding MarketPhase}" />
                        <TextBlock Classes="tertiary" VerticalAlignment="Center"
                                   Text="{Binding MarketCountdown}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Connection pill. Visible on every screen by design: silently stale
                             prices are the dangerous failure mode for this product. -->
                        <Border Classes="pill" ToolTip.Tip="{Binding Status.Detail}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource ConnBrush}}" />
                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding Status, Converter={StaticResource ConnText}}" />
                            </StackPanel>
                        </Border>

                        <Button Classes="chip" Content="Тема"
                                Command="{Binding ToggleThemeCommand}"
                                AutomationProperties.Name="Переключить светлую и тёмную тему" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ============ degraded / stale banner ============ -->
            <Border Classes="banner" DockPanel.Dock="Top" IsVisible="{Binding IsStale}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Котировки не обновлялись более 10 секунд, хотя биржа открыта. Данные на экране могут быть устаревшими." />
                    <Button Classes="link" Content="Переподключиться" Command="{Binding ReconnectCommand}" />
                </StackPanel>
            </Border>

            <Border Classes="banner error" DockPanel.Dock="Top"
                    IsVisible="{Binding Status.IsTerminal}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⛔" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Status.Detail}" />
                    <Button Classes="link" Content="Открыть настройки"
                            Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
            </Border>

            <!-- ============ status bar ============ -->
            <Border Classes="statusbar" DockPanel.Dock="Bottom">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="tertiary" Text="{Binding ServerAddress}" />

                    <TextBlock Grid.Column="1" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="Обновлений/с:" />
                        <Run Text="{Binding UpdatesPerSecond}" />
                    </TextBlock>

                    <TextBlock Grid.Column="2" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="Возраст данных:" />
                        <Run Text="{Binding DataAge}" />
                    </TextBlock>

                    <TextBlock Grid.Column="4" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="Сигналов сегодня:" />
                        <Run Text="{Binding SignalsToday}" />
                    </TextBlock>

                    <TextBlock Grid.Column="5" Classes="tertiary" Margin="16,0,0,0"
                               Text="{Binding AccountName}" />
                </Grid>
            </Border>

            <!-- ============ rail + page ============ -->
            <Grid ColumnDefinitions="Auto,*">

                <Border Grid.Column="0" Classes="rail" Width="{Binding RailWidth}">
                    <ListBox Classes="rail"
                             Classes.collapsed="{Binding !IsRailExpanded}"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding CurrentPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Title}">
                                    <PathIcon Grid.Column="0" Classes="rail"
                                              Data="{Binding IconKey, Converter={StaticResource Icon}}" />
                                    <TextBlock Grid.Column="1" Classes="raillabel" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="{Binding Title}" />
                                    <Border Grid.Column="2" Classes="pill raillabel" Padding="6,1"
                                            IsVisible="{Binding HasBadge}">
                                        <TextBlock FontSize="11" Text="{Binding Badge}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Pages are kept alive, so switching back restores scroll and selection. -->
                <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.12" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>

            </Grid>

        </DockPanel>

        <!-- ============ first-run onboarding ============ -->
        <ContentControl Content="{Binding Onboarding}"
                        IsVisible="{Binding IsOnboarding}"
                        Background="{DynamicResource Brush.Surface.1}" />

    </Panel>
</Window>
