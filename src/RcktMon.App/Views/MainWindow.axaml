<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RcktMon.App.Localization"
        xmlns:vm="using:RcktMon.App.ViewModels"
        xmlns:fmt="using:RcktMon.App.Formatting"
        x:Class="RcktMon.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RocketMon"
        Width="1360" Height="860"
        MinWidth="360" MinHeight="480"
        Background="{DynamicResource Brush.Surface.1}">

    <Window.Resources>
        <fmt:ConnectionTextConverter x:Key="ConnText" />
        <fmt:ConnectionBrushConverter x:Key="ConnBrush" />
        <fmt:ResourceLookupConverter x:Key="Icon" />
    </Window.Resources>

    <Panel>

        <DockPanel IsEnabled="{Binding !IsOnboarding}">

            <!-- ============ app bar ============ -->
            <Border Classes="appbar" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="ghost" IsVisible="{DynamicResource Shell.Wide}" Command="{Binding ToggleRailCommand}"
                                AutomationProperties.Name="{l:Localize Shell_ToggleRail}">
                            <PathIcon Classes="rail" Data="{DynamicResource Icon.Instruments}" />
                        </Button>

                        <TextBlock Text="RocketMon" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />

                        <TextBlock Classes="tertiary" IsVisible="{DynamicResource Shell.Wide}" VerticalAlignment="Center"
                                   Text="{Binding CurrentPage.Title}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" IsVisible="{Binding ShowMarketStatus}" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="secondary" IsVisible="{DynamicResource Shell.Wide}" VerticalAlignment="Center"
                                   Text="{Binding MarketPhase}" />
                        <TextBlock Classes="tertiary" IsVisible="{DynamicResource Shell.Wide}" VerticalAlignment="Center"
                                   Text="{Binding MarketCountdown}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="ServerSetupButton" Classes="chip" Command="{Binding BeginServerSetupCommand}"
                                IsVisible="{Binding ShowSetupShortcut}" Content="{l:Localize Shell_ConnectMonitor}" />
                        <!-- The monitor and local Studio use different data sources. -->
                        <Border IsVisible="{Binding ShowMarketStatus}" Classes="pill" ToolTip.Tip="{Binding Status.Detail}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource ConnBrush}}" />
                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding Status, Converter={StaticResource ConnText}}" />
                            </StackPanel>
                        </Border>

                        <Button Classes="chip" IsVisible="{DynamicResource Shell.Wide}" Content="{l:Localize Settings_Theme}"
                                Command="{Binding ToggleThemeCommand}"
                                AutomationProperties.Name="{l:Localize Shell_ToggleTheme}" />
                    </StackPanel>

                </Grid>
            </Border>

            <ComboBox x:Name="PagePicker" DockPanel.Dock="Top" Margin="12,6"
                      IsVisible="{DynamicResource Shell.Narrow}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:Localize Shell_PagePicker}" ItemsSource="{Binding Pages}"
                      SelectedItem="{Binding CurrentPage}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageViewModel"><TextBlock Text="{Binding Title}"/></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- ============ degraded / stale banner ============ -->
            <Border Classes="banner" DockPanel.Dock="Top" IsVisible="{Binding ShowStaleBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="⚠" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{l:Localize Shell_StaleBanner}" />
                    <Button Grid.Column="2" Classes="link" Content="{l:Localize Common_Reconnect}" Command="{Binding ReconnectCommand}" />
                </Grid>
            </Border>

            <Border Classes="banner error" DockPanel.Dock="Top" IsVisible="{Binding ShowTerminalBanner}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Status.Detail}" Text="{Binding Status.Detail}" />
                    <Button Grid.Column="1" Classes="link" Content="{l:Localize Shell_OpenSettings}"
                            Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </Grid>
            </Border>

            <!-- ============ status bar ============ -->
            <Border Classes="statusbar" DockPanel.Dock="Bottom" IsVisible="{Binding ShowMarketStatus}">
                <Grid IsVisible="{DynamicResource Shell.Wide}" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="tertiary" Text="{Binding ServerAddress}" />

                    <TextBlock Grid.Column="1" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="{l:Localize Shell_UpdatesPerSecond}" />
                        <Run Text="{Binding UpdatesPerSecond}" />
                    </TextBlock>

                    <TextBlock Grid.Column="2" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="{l:Localize Shell_DataAge}" />
                        <Run Text="{Binding DataAge}" />
                    </TextBlock>

                    <TextBlock Grid.Column="4" Classes="tertiary" Margin="16,0,0,0">
                        <Run Text="{l:Localize Shell_SignalsToday}" />
                        <Run Text="{Binding SignalsToday}" />
                    </TextBlock>

                    <TextBlock Grid.Column="5" Classes="tertiary" Margin="16,0,0,0"
                               Text="{Binding AccountName}" />
                </Grid>
            </Border>

            <!-- ============ rail + page ============ -->
            <Grid ColumnDefinitions="Auto,*">

                <Border Grid.Column="0" Classes="rail" Width="{Binding RailWidth}" IsVisible="{DynamicResource Shell.Wide}">
                    <ListBox x:Name="PageRail" Classes="rail" AutomationProperties.Name="{l:Localize Shell_PagePicker}"
                             Classes.collapsed="{Binding !IsRailExpanded}"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding CurrentPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                    <PathIcon Grid.Column="0" Classes="rail"
                                              Data="{Binding IconKey, Converter={StaticResource Icon}}" />
                                    <TextBlock Grid.Column="1" Classes="raillabel" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="{Binding Title}" />
                                    <Border Grid.Column="2" Classes="pill raillabel" Padding="6,1"
                                            IsVisible="{Binding HasBadge}">
                                        <TextBlock FontSize="11" Text="{Binding Badge}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1">
                    <!-- The original monitor screens contain desktop tables/toolbars. In a
                         compact shell they retain their desktop width inside this pan area. -->
                    <ScrollViewer x:Name="RemoteScroller" IsVisible="{Binding !IsLocalPage}"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="RemoteContent" Content="{Binding RemotePage}"/>
                    </ScrollViewer>
                    <Border x:Name="OfflineCard" Classes="card" IsVisible="{Binding ShowOfflineMonitor}"
                            Margin="16" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h2" TextWrapping="Wrap" Text="{l:Localize Shell_MonitorOfflineTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{l:Localize Shell_OfflineMonitor}"/>
                            <Button Classes="chip" Content="{l:Localize Shell_ConnectMonitor}" Command="{Binding BeginServerSetupCommand}"/>
                        </StackPanel>
                    </Border>
                    <!-- Remove inactive children from the visual tree: subscriptions stop and
                         local confirmations are revoked, without waking an unvisited page. -->
                    <ContentControl x:Name="LocalContent" IsVisible="{Binding IsLocalPage}"/>
                </Grid>

            </Grid>

        </DockPanel>

        <!-- ============ first-run onboarding ============ -->
        <ContentControl Content="{Binding Onboarding}"
                        IsVisible="{Binding IsOnboarding}"
                        Background="{DynamicResource Brush.Surface.1}" />

    </Panel>
</Window>
