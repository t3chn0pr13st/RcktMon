<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RcktMon.App.Localization"
             xmlns:vm="using:RcktMon.App.ViewModels"
             xmlns:fmt="using:RcktMon.App.Formatting"
             xmlns:market="using:RcktMon.Client.Core.Market"
             x:Class="RcktMon.App.Views.InstrumentsView"
             x:DataType="vm:InstrumentsViewModel">

    <UserControl.Resources>
        <fmt:TradingStatusConverter x:Key="StatusText" />
        <fmt:RelativeTimeConverter x:Key="Ago" />
        <fmt:InactiveOpacityConverter x:Key="InactiveOpacity" />
        <fmt:YesNoConverter x:Key="YesNo" />
    </UserControl.Resources>

    <DockPanel>

        <!-- ============ server health ============ -->
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,10" Spacing="12">

            <TextBlock Classes="h1" Text="{l:Localize Nav_Instruments}" />

            <Border Classes="card" Padding="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Positive}"
                                     IsVisible="{Binding !IsDegraded}" />
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Warning}"
                                     IsVisible="{Binding IsDegraded}" />
                            <TextBlock Classes="h2" Text="{l:Localize Instruments_Health}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{Binding HealthDetail}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{l:Localize Instruments_Shards}" />
                            <TextBlock Classes="mono">
                                <Run Text="{Binding ShardsHealthy}" /><Run Text=" / " /><Run Text="{Binding ShardsTotal}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="label" Text="{l:Localize Instruments_Subscribed}" />
                            <TextBlock Classes="mono" Text="{Binding SubscribedCount}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Both time zones, always. A schedule shown only in Moscow time is wrong for
                 every user outside Moscow, which is exactly the bug being replaced. -->
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExchangeSessionRow">
                        <Border Classes="card" Padding="14,10" MinWidth="260">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Exchange}" />
                                    <TextBlock Classes="tertiary" Text="{Binding Phase}" />
                                </StackPanel>
                                <TextBlock Classes="secondary" FontSize="12">
                                    <Run Text="{l:Localize Instruments_Local}" /><Run Text=" " /><Run Text="{Binding LocalWindow}" />
                                </TextBlock>
                                <TextBlock Classes="tertiary" FontSize="12">
                                    <Run Text="MSK:" /><Run Text=" " /><Run Text="{Binding MoscowWindow}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Classes="search" Width="280" PlaceholderText="{l:Localize Instruments_SearchPlaceholder}"
                         Text="{Binding SearchText}" />
                <ToggleButton Classes="chip" Content="{l:Localize Instruments_TradableOnly}" IsChecked="{Binding TradableOnly}" />
                <ToggleButton Classes="chip" Content="{l:Localize Instruments_ShortableOnly}" IsChecked="{Binding ShortableOnly}" />
                <Button Classes="chip" Content="{l:Localize Common_Reset}" Command="{Binding ClearFiltersCommand}" />
                <TextBlock Classes="tertiary" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="{l:Localize Instruments_Shown}" /><Run Text=" " /><Run Text="{Binding VisibleCount}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- ============ instrument table ============ -->
        <DataGrid ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False"
                  Margin="20,0,20,16">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="{l:Localize Col_Ticker}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                       Opacity="{Binding IsInactive, Converter={StaticResource InactiveOpacity}}"
                                       Text="{Binding Ticker}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Name}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Exchange}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding Exchange}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Class}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding ClassCode}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Status}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Status, Converter={StaticResource StatusText}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Data}" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Warning}"
                                         IsVisible="{Binding IsStale}" />
                                <TextBlock Classes="tertiary"
                                           Text="{Binding LastTradeTime, Converter={StaticResource Ago}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Short}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock Classes="secondary" VerticalAlignment="Center"
                                       Text="{Binding ShortEnabled, Converter={StaticResource YesNo}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_Lot}" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock Classes="numeric" VerticalAlignment="Center" Text="{Binding Lot}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{l:Localize Col_FirstCandle}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="market:InstrumentRow">
                            <TextBlock Classes="tertiary" VerticalAlignment="Center"
                                       Text="{Binding FirstCandleDate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
