<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RcktMon.App.Localization"
             xmlns:vm="using:RcktMon.App.ViewModels"
             xmlns:fmt="using:RcktMon.App.Formatting"
             x:Class="RcktMon.App.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel"
             Background="{DynamicResource Brush.Surface.1}">

    <UserControl.Resources>
        <fmt:ConnectionTextConverter x:Key="ConnText" />
        <fmt:ConnectionBrushConverter x:Key="ConnBrush" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto" MaxWidth="620" Margin="24">

        <!-- ============ step 1: welcome ============ -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="16" IsVisible="{Binding IsWelcome}">
            <TextBlock Text="RcktMon" FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Classes="h2" Text="{l:Localize Onb_Tagline}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:Localize Onb_Intro}" />
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="{l:Localize Onb_WhatChanged}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="{l:Localize Onb_WhatChangedBody}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ step 2: connect ============ -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14" IsVisible="{Binding IsConnect}">
            <TextBlock Classes="h1" Text="{l:Localize Settings_Connection}" />

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{l:Localize Settings_ServerAddress}" />
                <TextBox Classes="field" Text="{Binding ServerAddress}"
                         PlaceholderText="https://api.rcktmon.ru" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{l:Localize Settings_AccessKey}" />
                <TextBox Classes="field" PasswordChar="•" Text="{Binding AccessKey}" PlaceholderText="rm_…" />
                <TextBlock Classes="tertiary" TextWrapping="Wrap"
                           Text="{l:Localize Onb_KeyHint}" />
            </StackPanel>

            <Border Classes="card" Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource ConnBrush}}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Status, Converter={StaticResource ConnText}}" />
                    <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding AccountName}" />
                    <Button Classes="chip" Content="{l:Localize Onb_Check}" Command="{Binding ConnectCommand}" />
                </StackPanel>
            </Border>

            <TextBlock Foreground="{DynamicResource Brush.Negative}" TextWrapping="Wrap"
                       Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Classes="tertiary" TextWrapping="Wrap"
                       Text="{l:Localize Onb_NoBrokerToken}" />
        </StackPanel>

        <!-- ============ step 3: profile ============ -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14" IsVisible="{Binding IsProfile}">
            <TextBlock Classes="h1" Text="{l:Localize Onb_HowNoisy}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{l:Localize Onb_HowNoisyBody}" />

            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertProfileViewModel">
                        <RadioButton GroupName="preset" Margin="0,0,0,8"
                                     IsCheckedChanged="OnPresetChecked">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Classes="tertiary" Text="{Binding Summary}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Foreground="{DynamicResource Brush.Negative}" TextWrapping="Wrap"
                       Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- ============ navigation ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">

            <Button Grid.Column="0" Classes="ghost" Content="{l:Localize Common_Back}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding !IsWelcome}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Text.Tertiary}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Text.Tertiary}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Text.Tertiary}" />
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Content="{l:Localize Common_Skip}"
                    Command="{Binding FinishCommand}" />

            <Button Grid.Column="3" Classes="primary" Content="{l:Localize Common_Next}" Margin="10,0,0,0"
                    Command="{Binding NextCommand}"
                    IsVisible="{Binding !IsProfile}" />

            <Button Grid.Column="3" Classes="primary" Content="{l:Localize Common_Done}" Margin="10,0,0,0"
                    Command="{Binding ChoosePresetCommand}"
                    IsVisible="{Binding IsProfile}" />
        </Grid>

    </Grid>
</UserControl>
