<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RcktMon.App.ViewModels"
             xmlns:fmt="using:RcktMon.App.Formatting"
             x:Class="RcktMon.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <fmt:EnumMatchConverter x:Key="EnumIs" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="h1" Text="Настройки" />

                <!-- Saved as you type. No Apply button anywhere, on purpose. -->
                <Border Grid.Column="1" Classes="pill" IsVisible="{Binding ShowSaved}">
                    <TextBlock FontSize="12" Text="Сохранено" Foreground="{DynamicResource Brush.Positive}" />
                </Border>
            </Grid>

            <!-- ============ connection ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="Подключение" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Адрес сервера" />
                        <TextBox Classes="field" Text="{Binding ServerAddress}"
                                 PlaceholderText="https://api.rcktmon.ru" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Ключ доступа" />
                        <TextBox Classes="field" PasswordChar="•" Text="{Binding AccessKey}"
                                 PlaceholderText="rm_…" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap">
                            <Run Text="Хранится тут:" />
                            <Run Text="{Binding SecretBackend}" />
                        </TextBlock>
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="RcktMon никогда не спрашивает брокерский токен: котировки подписывает сервер своими ключами." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Интервал обновления, мс" />
                        <NumericUpDown Minimum="250" Maximum="5000" Increment="250" Width="160"
                                       Value="{Binding TickIntervalMs}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="Сервер сам ограничит значение своим диапазоном и тарифом аккаунта." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary" Content="Переподключиться"
                                Command="{Binding ReconnectCommand}" />
                        <TextBlock Classes="secondary" VerticalAlignment="Center"
                                   IsVisible="{Binding ConnectionNeedsRestart}"
                                   Text="Адрес или ключ изменились — применятся после переподключения." />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Идентификатор установки" />
                        <TextBlock Classes="mono" FontSize="12" Text="{Binding DeviceId}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="Не секрет. Нужен, чтобы владелец аккаунта видел и отзывал отдельные устройства." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ alert profiles ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="h2" Text="Профили оповещений" />
                        <Button Grid.Column="1" Classes="chip" Content="Обновить"
                                Command="{Binding ReloadProfilesCommand}" />
                    </Grid>

                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="{Binding ProfileError}"
                               Foreground="{DynamicResource Brush.Negative}"
                               IsVisible="{Binding ProfileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="220,*" ColumnSpacing="16">

                        <StackPanel Grid.Column="0" Spacing="8">
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertProfileViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="tertiary" Text="Активен"
                                                       IsVisible="{Binding IsActive}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="chip" Content="Сделать активным"
                                        Command="{Binding ActivateProfileCommand}" />
                                <Button Classes="chip" Content="Удалить"
                                        Command="{Binding DeleteProfileCommand}" />
                            </StackPanel>

                            <TextBlock Classes="label" Text="Начать с пресета" />
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertProfileViewModel">
                                        <Button Classes="chip" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UsePresetCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="tertiary" Text="{Binding Summary}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Название профиля" />
                                <TextBox Classes="field" Text="{Binding SelectedProfile.Name}" />
                            </StackPanel>

                            <!-- The live estimate is the whole point of the pane: a threshold
                                 slider with no feedback is guesswork. -->
                            <Border Background="{DynamicResource Brush.Surface.3}"
                                    CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="С этими порогами сработало бы примерно" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="mono" FontSize="24" FontWeight="SemiBold"
                                                   Text="{Binding EstimatedSignalsPerDay}" />
                                        <TextBlock Classes="secondary" VerticalAlignment="Bottom"
                                                   Text="сигналов в день" />
                                        <TextBlock Classes="tertiary" VerticalAlignment="Bottom"
                                                   Text="считаем…" IsVisible="{Binding IsPreviewing}" />
                                    </StackPanel>
                                    <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{Binding PreviewDetail}" />

                                    <ItemsControl ItemsSource="{Binding PreviewSamples}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedProfile.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertRuleGroupViewModel">
                                        <Border Classes="card" Margin="0,0,0,10" Padding="14">
                                            <StackPanel Spacing="10">

                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Classes="h2" Text="{Binding GroupKey}" />
                                                    <CheckBox Grid.Column="1" Content="Включено"
                                                              IsChecked="{Binding Enabled}" />
                                                    <CheckBox Grid.Column="2" Content="Telegram" Margin="12,0,0,0"
                                                              IsChecked="{Binding TelegramEnabled}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                                      ColumnSpacing="12" RowSpacing="10">

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="Дневное изменение, %" />
                                                        <NumericUpDown Minimum="0" Maximum="100" Increment="0.5"
                                                                       FormatString="0.##"
                                                                       Value="{Binding DayPricePercent}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="Объём, × среднего за день" />
                                                        <NumericUpDown Minimum="0" Maximum="50" Increment="0.1"
                                                                       FormatString="0.##"
                                                                       Value="{Binding DayVolumeMultiple}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="Изменение цены за N минут, %" />
                                                        <NumericUpDown Minimum="0" Maximum="100" Increment="0.25"
                                                                       FormatString="0.##"
                                                                       Value="{Binding WindowPricePercent}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="Объём за N минут, × среднего" />
                                                        <NumericUpDown Minimum="0" Maximum="50" Increment="0.1"
                                                                       FormatString="0.##"
                                                                       Value="{Binding WindowVolumeMultiple}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="Окно цены, минут" />
                                                        <NumericUpDown Minimum="1" Maximum="60" Increment="1"
                                                                       FormatString="0"
                                                                       Value="{Binding Minutes}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="Окно объёма, минут" />
                                                        <NumericUpDown Minimum="1" Maximum="60" Increment="1"
                                                                       FormatString="0"
                                                                       Value="{Binding VolumeMinutes}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="Только эти тикеры" />
                                                        <TextBox Classes="field" PlaceholderText="regex, пусто = все"
                                                                 Text="{Binding IncludePattern}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="Исключить тикеры" />
                                                        <TextBox Classes="field" PlaceholderText="regex"
                                                                 Text="{Binding ExcludePattern}" />
                                                    </StackPanel>
                                                </Grid>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ appearance ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="Внешний вид" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Тема" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <RadioButton GroupName="theme" Content="Как в системе"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=System}" />
                            <RadioButton GroupName="theme" Content="Светлая"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=Light}" />
                            <RadioButton GroupName="theme" Content="Тёмная"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=Dark}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Компактные строки в гриде" IsChecked="{Binding CompactDensity}" />
                    <CheckBox Content="Спарклайны в мониторе" IsChecked="{Binding ShowSparklines}" />

                    <StackPanel Spacing="2">
                        <CheckBox Content="Палитра для дальтоников (синий/оранжевый)"
                                  IsChecked="{Binding ColourBlindSafe}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap" MaxWidth="520"
                                   Text="Направление всегда дублируется стрелкой и знаком, так что цвет — второй канал, а не единственный." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ advanced ============ -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Дополнительно" />

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Каталог настроек" />
                        <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding ConfigDirectory}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Каталог логов" />
                        <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding LogDirectory}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
