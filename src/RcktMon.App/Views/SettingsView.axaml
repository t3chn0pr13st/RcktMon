<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RcktMon.App.Localization"
             xmlns:loc="using:RcktMon.App.Localization"
             xmlns:vm="using:RcktMon.App.ViewModels"
             xmlns:fmt="using:RcktMon.App.Formatting"
             x:Class="RcktMon.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <fmt:EnumMatchConverter x:Key="EnumIs" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="h1" Text="{l:Localize Nav_Settings}" />

                <!-- Saved as you type. No Apply button anywhere, on purpose. -->
                <Border Grid.Column="1" Classes="pill" IsVisible="{Binding ShowSaved}">
                    <TextBlock FontSize="12" Text="{l:Localize Common_Saved}" Foreground="{DynamicResource Brush.Positive}" />
                </Border>
            </Grid>

            <!-- ============ connection ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{l:Localize Settings_Connection}" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:Localize Settings_ServerAddress}" />
                        <TextBox Classes="field" Text="{Binding ServerAddress}"
                                 PlaceholderText="https://api.rcktmon.ru" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:Localize Settings_AccessKey}" />
                        <TextBox Classes="field" PasswordChar="•" Text="{Binding AccessKey}"
                                 PlaceholderText="rm_…" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap">
                            <Run Text="{l:Localize Settings_StoredIn}" />
                            <Run Text="{Binding SecretBackend}" />
                        </TextBlock>
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="{l:Localize Settings_NoBrokerToken}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:Localize Settings_TickInterval}" />
                        <NumericUpDown Minimum="250" Maximum="5000" Increment="250" Width="160"
                                       Value="{Binding TickIntervalMs}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="{l:Localize Settings_TickIntervalHint}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary" Content="{l:Localize Common_Reconnect}"
                                Command="{Binding ReconnectCommand}" />
                        <TextBlock Classes="secondary" VerticalAlignment="Center"
                                   IsVisible="{Binding ConnectionNeedsRestart}"
                                   Text="{l:Localize Settings_RestartHint}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="{l:Localize Settings_DeviceId}" />
                        <TextBlock Classes="mono" FontSize="12" Text="{Binding DeviceId}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                                   Text="{l:Localize Settings_DeviceIdHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ alert profiles ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="h2" Text="{l:Localize Settings_Profiles}" />
                        <Button Grid.Column="1" Classes="chip" Content="{l:Localize Common_Refresh}"
                                Command="{Binding ReloadProfilesCommand}" />
                    </Grid>

                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="{Binding ProfileError}"
                               Foreground="{DynamicResource Brush.Negative}"
                               IsVisible="{Binding ProfileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="220,*" ColumnSpacing="16">

                        <StackPanel Grid.Column="0" Spacing="8">
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertProfileViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="tertiary" Text="{l:Localize Settings_Active}"
                                                       IsVisible="{Binding IsActive}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="chip" Content="{l:Localize Settings_MakeActive}"
                                        Command="{Binding ActivateProfileCommand}" />
                                <Button Classes="chip" Content="{l:Localize Common_Delete}"
                                        Command="{Binding DeleteProfileCommand}" />
                            </StackPanel>

                            <TextBlock Classes="label" Text="{l:Localize Settings_StartFromPreset}" />
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertProfileViewModel">
                                        <Button Classes="chip" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UsePresetCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="tertiary" Text="{Binding Summary}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Localize Settings_ProfileName}" />
                                <TextBox Classes="field" Text="{Binding SelectedProfile.Name}" />
                            </StackPanel>

                            <!-- The live estimate is the whole point of the pane: a threshold
                                 slider with no feedback is guesswork. -->
                            <Border Background="{DynamicResource Brush.Surface.3}"
                                    CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="{l:Localize Settings_PreviewLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="mono" FontSize="24" FontWeight="SemiBold"
                                                   Text="{Binding EstimatedSignalsPerDay}" />
                                        <TextBlock Classes="secondary" VerticalAlignment="Bottom"
                                                   Text="{l:Localize Settings_PerDay}" />
                                        <TextBlock Classes="tertiary" VerticalAlignment="Bottom"
                                                   Text="{l:Localize Settings_Counting}" IsVisible="{Binding IsPreviewing}" />
                                    </StackPanel>
                                    <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{Binding PreviewDetail}" />

                                    <ItemsControl ItemsSource="{Binding PreviewSamples}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedProfile.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertRuleGroupViewModel">
                                        <Border Classes="card" Margin="0,0,0,10" Padding="14">
                                            <StackPanel Spacing="10">

                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Classes="h2" Text="{Binding GroupKey}" />
                                                    <CheckBox Grid.Column="1" Content="{l:Localize Settings_Enabled}"
                                                              IsChecked="{Binding Enabled}" />
                                                    <CheckBox Grid.Column="2" Content="Telegram" Margin="12,0,0,0"
                                                              IsChecked="{Binding TelegramEnabled}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                                      ColumnSpacing="12" RowSpacing="10">

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_DayChangePercent}" />
                                                        <NumericUpDown Minimum="0" Maximum="100" Increment="0.5"
                                                                       FormatString="0.##"
                                                                       Value="{Binding DayPricePercent}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_DayVolumeMultiple}" />
                                                        <NumericUpDown Minimum="0" Maximum="50" Increment="0.1"
                                                                       FormatString="0.##"
                                                                       Value="{Binding DayVolumeMultiple}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_WindowPricePercent}" />
                                                        <NumericUpDown Minimum="0" Maximum="100" Increment="0.25"
                                                                       FormatString="0.##"
                                                                       Value="{Binding WindowPricePercent}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_WindowVolumeMultiple}" />
                                                        <NumericUpDown Minimum="0" Maximum="50" Increment="0.1"
                                                                       FormatString="0.##"
                                                                       Value="{Binding WindowVolumeMultiple}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_PriceWindow}" />
                                                        <NumericUpDown Minimum="1" Maximum="60" Increment="1"
                                                                       FormatString="0"
                                                                       Value="{Binding Minutes}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_VolumeWindow}" />
                                                        <NumericUpDown Minimum="1" Maximum="60" Increment="1"
                                                                       FormatString="0"
                                                                       Value="{Binding VolumeMinutes}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_IncludeTickers}" />
                                                        <TextBox Classes="field" PlaceholderText="{l:Localize Settings_IncludePlaceholder}"
                                                                 Text="{Binding IncludePattern}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="{l:Localize Settings_ExcludeTickers}" />
                                                        <TextBox Classes="field" PlaceholderText="regex"
                                                                 Text="{Binding ExcludePattern}" />
                                                    </StackPanel>
                                                </Grid>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ appearance ============ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{l:Localize Settings_Appearance}" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:Localize Settings_Theme}" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <RadioButton GroupName="theme" Content="{l:Localize Settings_ThemeSystem}"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=System}" />
                            <RadioButton GroupName="theme" Content="{l:Localize Settings_ThemeLight}"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=Light}" />
                            <RadioButton GroupName="theme" Content="{l:Localize Settings_ThemeDark}"
                                         IsChecked="{Binding Theme, Converter={StaticResource EnumIs}, ConverterParameter=Dark}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="{l:Localize Settings_CompactRows}" IsChecked="{Binding CompactDensity}" />
                    <CheckBox Content="{l:Localize Settings_Sparklines}" IsChecked="{Binding ShowSparklines}" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:Localize Settings_Language}" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValue="{Binding Language}"
                                  SelectedValueBinding="{Binding Code}"
                                  AutomationProperties.Name="{l:Localize Settings_Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="loc:LanguageOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="tertiary" TextWrapping="Wrap" MaxWidth="520"
                                   Text="{l:Localize Settings_LanguageHint}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <CheckBox Content="{l:Localize Settings_ColourBlind}"
                                  IsChecked="{Binding ColourBlindSafe}" />
                        <TextBlock Classes="tertiary" TextWrapping="Wrap" MaxWidth="520"
                                   Text="{l:Localize Settings_ColourBlindHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ advanced ============ -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="{l:Localize Settings_Advanced}" />

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="{l:Localize Settings_ConfigDirectory}" />
                        <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding ConfigDirectory}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="{l:Localize Settings_LogDirectory}" />
                        <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding LogDirectory}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
