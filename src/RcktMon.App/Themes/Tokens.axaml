<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic design tokens. Views reference these by role, never by colour value.

        The pre-rewrite app hardcoded ten orange overrides in App.xaml plus #c05102,
        #fff100, #e81224, #886ce4, #0078d7 and #16c60c inline in MainView.xaml, which is
        why it had exactly one theme and no way to test contrast.

        The nine `Chg` buckets are discrete rather than a continuous converter for two
        reasons: each shade is theme-controlled, and each one can be contrast-checked
        individually. Every bucket below clears 4.5:1 against its own surface.

        Colour is never the only channel — the grid pairs these with an arrow glyph and a
        signed number. Themes/ColourBlind.axaml swaps this palette for a blue/orange one.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= DARK (default) ================= -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="Brush.Surface.1" Color="#14161A" />
            <SolidColorBrush x:Key="Brush.Surface.2" Color="#1B1F25" />
            <SolidColorBrush x:Key="Brush.Surface.3" Color="#232830" />
            <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#2A303A" />
            <SolidColorBrush x:Key="Brush.Border" Color="#2E343D" />
            <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3C444F" />

            <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E8EAED" />
            <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A0A7B4" />
            <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6C7480" />
            <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#14161A" />

            <!-- Brand orange, carried over from the WPF build for continuity. -->
            <SolidColorBrush x:Key="Brush.Accent" Color="#FF7A18" />
            <SolidColorBrush x:Key="Brush.Accent.Muted" Color="#26FF7A18" />

            <SolidColorBrush x:Key="Brush.Positive" Color="#22E06E" />
            <SolidColorBrush x:Key="Brush.Negative" Color="#FF3B3B" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#F5A524" />
            <SolidColorBrush x:Key="Brush.Warning.Muted" Color="#26F5A524" />
            <SolidColorBrush x:Key="Brush.Negative.Muted" Color="#26FF3B3B" />

            <!-- Diverging change ramp: saturation carries magnitude on a dark surface. -->
            <SolidColorBrush x:Key="Brush.Chg.Up.4" Color="#22E06E" />
            <SolidColorBrush x:Key="Brush.Chg.Up.3" Color="#4CDE86" />
            <SolidColorBrush x:Key="Brush.Chg.Up.2" Color="#6FDB9A" />
            <SolidColorBrush x:Key="Brush.Chg.Up.1" Color="#8FD9AE" />
            <SolidColorBrush x:Key="Brush.Chg.Neutral" Color="#A0A7B4" />
            <SolidColorBrush x:Key="Brush.Chg.Down.1" Color="#F0A8A8" />
            <SolidColorBrush x:Key="Brush.Chg.Down.2" Color="#F58585" />
            <SolidColorBrush x:Key="Brush.Chg.Down.3" Color="#FA6060" />
            <SolidColorBrush x:Key="Brush.Chg.Down.4" Color="#FF3B3B" />

            <SolidColorBrush x:Key="Brush.Chg.Neutral.Fill" Color="Transparent" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.4" Color="#3322E06E" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.3" Color="#2622E06E" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.2" Color="#1A22E06E" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.1" Color="#0F22E06E" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.1" Color="#0FFF3B3B" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.2" Color="#1AFF3B3B" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.3" Color="#26FF3B3B" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.4" Color="#33FF3B3B" />

            <SolidColorBrush x:Key="Brush.VolumeBar" Color="#33FF7A18" />
            <SolidColorBrush x:Key="Brush.Flash.Up" Color="#4022E06E" />
            <SolidColorBrush x:Key="Brush.Flash.Down" Color="#40FF3B3B" />

        </ResourceDictionary>

        <!-- ================= LIGHT ================= -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="Brush.Surface.1" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.Surface.2" Color="#F5F6F8" />
            <SolidColorBrush x:Key="Brush.Surface.3" Color="#EBEDF1" />
            <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#E2E5EA" />
            <SolidColorBrush x:Key="Brush.Border" Color="#D8DCE3" />
            <SolidColorBrush x:Key="Brush.Border.Strong" Color="#B9C0CA" />

            <SolidColorBrush x:Key="Brush.Text.Primary" Color="#16181D" />
            <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#545B66" />
            <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#79808B" />
            <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="Brush.Accent" Color="#C2540A" />
            <SolidColorBrush x:Key="Brush.Accent.Muted" Color="#22C2540A" />

            <SolidColorBrush x:Key="Brush.Positive" Color="#14532D" />
            <SolidColorBrush x:Key="Brush.Negative" Color="#7F1D1D" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#92400E" />
            <SolidColorBrush x:Key="Brush.Warning.Muted" Color="#1E92400E" />
            <SolidColorBrush x:Key="Brush.Negative.Muted" Color="#1E7F1D1D" />

            <!-- On a light surface, magnitude reads as depth rather than brightness. -->
            <SolidColorBrush x:Key="Brush.Chg.Up.4" Color="#14532D" />
            <SolidColorBrush x:Key="Brush.Chg.Up.3" Color="#1F6B41" />
            <SolidColorBrush x:Key="Brush.Chg.Up.2" Color="#2C7A4E" />
            <SolidColorBrush x:Key="Brush.Chg.Up.1" Color="#35855A" />
            <SolidColorBrush x:Key="Brush.Chg.Neutral" Color="#545B66" />
            <SolidColorBrush x:Key="Brush.Chg.Down.1" Color="#D24040" />
            <SolidColorBrush x:Key="Brush.Chg.Down.2" Color="#C13030" />
            <SolidColorBrush x:Key="Brush.Chg.Down.3" Color="#A81F1F" />
            <SolidColorBrush x:Key="Brush.Chg.Down.4" Color="#7F1D1D" />

            <SolidColorBrush x:Key="Brush.Chg.Neutral.Fill" Color="Transparent" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.4" Color="#2614532D" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.3" Color="#1C14532D" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.2" Color="#1214532D" />
            <SolidColorBrush x:Key="Brush.Chg.Up.Fill.1" Color="#0A14532D" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.1" Color="#0A7F1D1D" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.2" Color="#127F1D1D" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.3" Color="#1C7F1D1D" />
            <SolidColorBrush x:Key="Brush.Chg.Down.Fill.4" Color="#267F1D1D" />

            <SolidColorBrush x:Key="Brush.VolumeBar" Color="#33C2540A" />
            <SolidColorBrush x:Key="Brush.Flash.Up" Color="#3014532D" />
            <SolidColorBrush x:Key="Brush.Flash.Down" Color="#307F1D1D" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Non-colour tokens: shared across variants. -->
    <x:Double x:Key="Size.Row.Compact">28</x:Double>
    <x:Double x:Key="Size.Row.Comfortable">36</x:Double>
    <x:Double x:Key="Size.Rail.Expanded">208</x:Double>
    <x:Double x:Key="Size.Rail.Collapsed">56</x:Double>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Space.Panel">16</Thickness>

    <!--
        Rail and page icons.

        Fill-only geometry rather than an icon font: a font is another asset to license,
        ship and fall back from, and seven shapes do not justify one.
    -->
    <StreamGeometry x:Key="Icon.Dashboard">M3,3 H10 V10 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,14 H10 V21 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Monitor">M4,13 H8 V20 H4 Z M10,6 H14 V20 H10 Z M16,10 H20 V20 H16 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Signals">M13,2 L4,14 H11 L10,22 L20,9 H13 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Instruments">M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H21 V19 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M4,6 H20 V8 H4 Z M7,3.5 H9 V10.5 H7 Z M4,16 H20 V18 H4 Z M15,13.5 H17 V20.5 H15 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Star">M12,2.5 L14.9,8.6 L21.5,9.5 L16.7,14.1 L17.9,20.7 L12,17.6 L6.1,20.7 L7.3,14.1 L2.5,9.5 L9.1,8.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M6,7.4 L7.4,6 L12,10.6 L16.6,6 L18,7.4 L13.4,12 L18,16.6 L16.6,18 L12,13.4 L7.4,18 L6,16.6 L10.6,12 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Search">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 Z M10,5 A5,5 0 1 1 10,15 A5,5 0 1 1 10,5 Z M15.5,14 L21,19.5 L19.5,21 L14,15.5 Z</StreamGeometry>

</ResourceDictionary>
